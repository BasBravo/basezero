{
    "name": "@basezero/web",
    "version": "0.1.0",
    "description": "Nuevo sitio de Basezero con Next.js, React y shadcn/ui",
    "author": "Bas Bravo <hello@basezero.dev>",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.26.1",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "dev": "next dev -p ${PORT:-3000}",
        "build": "next build",
        "start": "next start -p ${PORT:-3000}",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "migrate:env": "node scripts/migrate-legacy-env.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/bricolage-grotesque": "^5.2.10",
        "@fontsource-variable/space-grotesk": "^5.2.10",
        "@react-three/fiber": "^9.7.0",
        "@tabler/icons-react": "^3.45.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/three": "^0.185.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "^12.15.0",
        "lucide-react": "^1.31.0",
        "next": "^16.2.10",
        "next-intl": "^4.13.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.185.1",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "eslint": "^9.39.0",
        "eslint-config-next": "^16.2.10",
        "jsdom": "^30.0.1",
        "shadcn": "^4.13.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.6"
    }
}
